# TypeSafe SDK with Local Ollama Configuration
# Default Ollama instance runs at http://localhost:11434
TYPESAFE_BASE_URL=http://localhost:11434

# The SDK requires a non-empty string, but Ollama does not validate it
TYPESAFE_API_KEY=ollama

# Model name installed in Ollama (e.g. tev1:0.8b, tev1:4b, nimble)
TYPESAFE_DEFAULT_MODEL=tev1:0.8b
